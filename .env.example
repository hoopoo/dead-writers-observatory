# Curator Console (optional in production; token required if enabled)
# CURATOR_ENABLED=true
# CURATOR_TOKEN=replace-me

# Optional override for review SQLite path
# CURATOR_REVIEW_DB_PATH=./data/curator-reviews.sqlite

# Retrieval mode for public observe path: deterministic | semantic | hybrid
# Keep deterministic until semantic/hybrid evaluation is accepted.
RETRIEVAL_MODE=deterministic

# Embedding provider: local-bridge (default) | openai
EMBEDDING_PROVIDER=local-bridge
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Hybrid weights (normalized 0..1 combine) — config only; do not tune on one fixture
SEMANTIC_WEIGHT=0.65
DETERMINISTIC_WEIGHT=0.35

# Evidence-bounded claim skeleton on /observe (default off)
# EVIDENCE_BOUNDED_SKELETON=true
# Or use /observe?q=...&skeleton=1

# Claim generation mode (public observe stays deterministic regardless)
# GENERATION_MODE=deterministic-claims
# llm-claims / llm-prose are experiment labels; prose is not implemented

# LLM Claim Proposal (Curator experiments only — never on public /observe)
# CLAIM_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_CLAIM_MODEL=gpt-4o-mini
# CLAIM_LLM_API_KEY=
# CLAIM_LLM_MODEL=gpt-4o-mini
# CLAIM_LLM_TEMPERATURE=0.2
# LLM_CLAIM_PROMPT_VERSION=v1

# Staging claim skeleton on /observe (default off — production unchanged)
# STAGING_CLAIMS=true
# Or /observe?q=...&stagingClaims=1

# Experiment C (neural-hybrid + approved LLM claims) — staging only
# EXPERIMENT_C=true
# Or /observe?q=...&experiment=C
# Or /observe?q=...&stagingClaims=1&retrieval=neural-hybrid

# Meaning-preserving prose editor (research / freeze generation)
# PROSE_LLM_PROVIDER=openai
# OPENAI_PROSE_MODEL=gpt-4o-mini
# PROSE_PROMPT_VERSION=v1

# Deprecated research flags (do not use as public default):
# STAGING_PROSE=true
# PUBLIC_BETA_PROSE=true
# /observe?q=...&prose=1  → research UI only

# Public Beta v0.1 production source of truth
PUBLIC_PERSPECTIVE_MODE=skeleton
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Production must leave ALL of these unset:
# STAGING_MODE_OVERRIDE
# STAGING_PROSE
# PUBLIC_BETA_PROSE
# EXPERIMENT_C
# STAGING_CLAIMS
# EVIDENCE_BOUNDED_SKELETON
